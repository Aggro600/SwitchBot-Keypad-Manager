        "title": "SwitchBot account",
        "data": {
          "username": "E-mail",
          "password": "Password"
        }
      },
      "key_manual": {
        "title": "Enter key",
        "data": {
          "key_id": "Key ID (2 characters)",
          "encryption_key": "Encryption key (32 characters)"
        }
      },
      "reauth_confirm": {
        "title": "Keypad connection",
        "description": "Since 2.0 the integration talks to the keypad itself. Pick the keypad of {title} once, then the key.",
        "data": {
          "address": "Keypad"
        }
      },
      "keypad": {
        "title": "Set up SwitchBot Keypad Manager",
        "description": "Pick the keypad (seen by Home Assistant's Bluetooth or an ESPHome Bluetooth proxy) and the ESPHome keypad bridge that reports who unlocked.",
