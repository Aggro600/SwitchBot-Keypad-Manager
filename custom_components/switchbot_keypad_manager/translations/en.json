          "address": "Keypad",
          "bridge": "Keypad bridge (ESPHome device)",
          "name": "Name (optional)",
          "persons": "People in the selection"
        }
      },
      "user": {
        "title": "What do you want to add?",
        "menu_options": {
          "keypad": "Keypad Vision (Pro) – user management",
          "lock": "Lock Ultra – settings (speed, sound, auto-lock, night mode …)"
        }
      },
      "lock": {
        "title": "Lock settings",
        "description": "Pick the lock (seen by Home Assistant's Bluetooth or an ESPHome Bluetooth proxy).",
        "data": {
          "address": "Lock",
          "name": "Name (optional)"
        }
      }
    },
    "error": {
      "auth_failed": "SwitchBot login failed",
