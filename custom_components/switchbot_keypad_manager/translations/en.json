      "key": {
        "title": "Encryption key",
        "description": "The keypad encrypts its commands. Get the key with your SwitchBot account (used once, not stored) or enter it yourself.",
        "menu_options": {
          "key_login": "With SwitchBot account",
          "key_manual": "Enter key ID and key"
        }
      },
